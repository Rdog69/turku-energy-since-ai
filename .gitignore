# --- Organiser data ---
# starter_package/ IS committed on purpose (team decision, 6 Nov): this repo is PRIVATE.
# Nord Pool spot data is licensed: never make this repo public or push it elsewhere
# without first purging starter_package/data/ from the git history. Delete after the event.
# starter_package/.gitignore ignores data/, so its files were added once with `git add -f`.
starter_package_v1/
TurkuEnergia_SinceAI2026/
*.zip
# root-level data folder only (a bare "data/" would also hide the code in src/data/)
/data/
# raw API response caches (the tidy parquet tables next to them are committed)
external_data/**/raw/
# full demo export is ~20 MB; a small sample goes into the dashboard app instead
app_demo_data/
*.parquet
# open external data tables (CC BY 4.0, see SOURCES.md) are committed despite *.parquet above
# (exceptions must come after the rule they override)
!external_data/fingrid/fingrid_rt.parquet
!external_data/open_meteo/ecmwf_ifs025.parquet
!external_data/open_meteo/ecmwf_ifs025_extra.parquet
!external_data/open_meteo/icon_eu.parquet
!external_data/open_meteo/ecmwf_ifs025_nordic.parquet
!external_data/osm/*.parquet
spot_nordpool*.csv
# pre-June history: holds 2025 spot prices (Elering, from Nord Pool), team-internal only
external_data/history/
actuals_*.csv
forecast_backtest*.csv
results/
baseline_output/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.env
.kimi/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Node (dashboard) ---
node_modules/
dist/
build/

