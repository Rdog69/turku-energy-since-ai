# --- Organiser data ---
# starter_package/ IS committed on purpose (team decision, 6 Nov): this repo is PRIVATE.
# Nord Pool spot data is licensed: never make this repo public or push it elsewhere
# without first purging starter_package/data/ from the git history. Delete after the event.
# starter_package/.gitignore ignores data/, so its files were added once with `git add -f`.
starter_package_v1/
TurkuEnergia_SinceAI2026/
*.zip
data/
# our code lives in src/data/; the rule above is meant for data folders only
!src/data/
*.parquet
spot_nordpool*.csv
actuals_*.csv
forecast_backtest*.csv
results/
baseline_output/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.env
.kimi/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Node (dashboard) ---
node_modules/
dist/
build/

# --- OS / editors ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# experiment outputs
*.npz

# external data: raw API cache and logs stay local; processed csv.gz files are committed
external_data/_cache/
external_data/_log_*.txt

# lab caches (features, predictions)
experiments/lab/_cache/
submissions/score_*/

# loop console logs
experiments/lab/_loop_run*.txt
experiments/lab/_post_run*.txt

# rebuilt locally by experiments/lab/build_package_ext.py (contains licensed spot data)
external_data/history/package_ext/

# front-end: keep the type declarations, never the generated payload (licensed spot prices)
!frontend/src/data/
frontend/public/payload.json
